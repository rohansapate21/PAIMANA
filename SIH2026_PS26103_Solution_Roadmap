### **Phase 11 — Database Schema**

**Objective:** Normalized, query-efficient operational store supporting both the dashboard and ML retraining loop.

```sql
-- Entity table: one row per project
CREATE TABLE project_master (
    project_uid           VARCHAR(50) PRIMARY KEY,
    original_project_id   VARCHAR(50),
    project_name          TEXT NOT NULL,
    ministry               VARCHAR(150) NOT NULL,
    sector                 VARCHAR(100) NOT NULL,
    state                   VARCHAR(100),
    original_cost_cr       NUMERIC(14,2),
    original_sanction_date  DATE,
    original_completion_date DATE,
    date_precision           VARCHAR(10),
    first_seen_report_month DATE,
    last_seen_report_month  DATE,
    created_at               TIMESTAMP DEFAULT now(),
    updated_at               TIMESTAMP DEFAULT now()
);

-- Fact table: one row per project per report month (the time-series core)
CREATE TABLE project_month_panel (
    id                     BIGSERIAL PRIMARY KEY,
    project_uid            VARCHAR(50) REFERENCES project_master(project_uid),
    report_month            DATE NOT NULL,
    revised_cost_cr          NUMERIC(14,2),
    expenditure_cr           NUMERIC(14,2),
    physical_progress_pct    NUMERIC(5,2),
    project_status            VARCHAR(30),
    delta_cost_cr              NUMERIC(14,2),
    delta_progress_pct         NUMERIC(5,2),
    progress_stagnation_streak SMALLINT,
    cost_revision_count        SMALLINT,
    is_imputed_flags           JSONB,
    outlier_flag                BOOLEAN DEFAULT FALSE,
    date_anomaly_flag           BOOLEAN DEFAULT FALSE,
    UNIQUE(project_uid, report_month)
);

-- ML outputs
CREATE TABLE risk_scores (
    id               BIGSERIAL PRIMARY KEY,
    project_uid       VARCHAR(50) REFERENCES project_master(project_uid),
    report_month       DATE NOT NULL,
    cost_overrun_prob   NUMERIC(5,4),
    delay_risk_prob      NUMERIC(5,4),
    risk_score            NUMERIC(5,2),
    risk_band              VARCHAR(10),
    model_version           VARCHAR(20),
    scored_at                TIMESTAMP DEFAULT now(),
    UNIQUE(project_uid, report_month, model_version)
);

CREATE TABLE explanations (
    id            BIGSERIAL PRIMARY KEY,
    risk_score_id  BIGINT REFERENCES risk_scores(id),
    feature_name    VARCHAR(100),
    shap_value       NUMERIC(10,4),
    explanation_text TEXT
);

CREATE TABLE alerts (
    id            BIGSERIAL PRIMARY KEY,
    project_uid    VARCHAR(50) REFERENCES project_master(project_uid),
    report_month    DATE NOT NULL,
    alert_type       VARCHAR(50),   -- 'stagnation','cost_spike','ml_high_risk','risk_jump'
    severity          VARCHAR(10),
    reason             TEXT,
    created_at          TIMESTAMP DEFAULT now(),
    acknowledged        BOOLEAN DEFAULT FALSE
);

CREATE TABLE users (
    id            BIGSERIAL PRIMARY KEY,
    email          VARCHAR(150) UNIQUE NOT NULL,
    hashed_password TEXT NOT NULL,
    role             VARCHAR(20),   -- 'admin','analyst','viewer'
    ministry_scope    VARCHAR(150), -- nullable; restricts data visibility if set
    created_at          TIMESTAMP DEFAULT now()
);

CREATE TABLE ingestion_log (
    id            BIGSERIAL PRIMARY KEY,
    report_month   DATE NOT NULL,
    rows_extracted  INT,
    warnings_count   INT,
    status            VARCHAR(20),
    run_at             TIMESTAMP DEFAULT now()
);
```

**Indexes:** `(ministry, sector, state)` composite on `project_master`; `(report_month, risk_band)` on `risk_scores`; `(report_month)` on `project_month_panel`.

**Recommended Tools:** PostgreSQL 15+, Alembic for migrations, SQLAlchemy ORM.

