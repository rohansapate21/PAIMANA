# ============================================================
# SIH 2026 — PS26103 | Environment Configuration
# Copy this file to .env and fill in the values
# ============================================================

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sih2026_paimana
POSTGRES_USER=paimana_admin
POSTGRES_PASSWORD=changeme_in_production

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Backend / FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=sih2026-paimana-risk

# --- Data Paths ---
SOURCE_PDFS_DIR=./data/source_pdfs
RAW_ZONE_DIR=./data/raw_zone
MASTER_DIR=./data/master
MODEL_DIR=./ml/models

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
